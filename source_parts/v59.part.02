,\mathbf b$, write $\mathbf a:\mathbf b:=\{x\in K:x\mathbf b\subseteq\mathbf a\}$ and $\mathbf a^{-1}:=R:\mathbf a$; for an $R$-module $M$, write $\operatorname{Ann}_R(M):=\{a\in R:aM=0\}$.

Let $Q=(q_1\ \cdots\ q_n)$ and $\mathbf1=(1,\ldots,1)^T$. Since $QI_nQ^T=I_n$, one has $\lambda\in L_Q$ if and only if $\lambda+c\mathbf1\in L_Q$ for every $c\in R$.

\begin{definition}\label{def:difference-coordinate}
Choose the $n$th coordinate as reference and put $x_i:=\lambda_i-\lambda_n$ for $1\le i\le n-1$. The \emph{difference-coordinate module} is
\begin{equation}
D_Q:=\left\{x=(x_1,\ldots,x_{n-1})^T\in R^{n-1}:
\sum_{i=1}^{n-1}x_iq_iq_i^T\in M_n(R)\right\}.
\end{equation}
\end{definition}

For every $k\in\{1,\ldots,n\}$, the family $\{q_iq_i^T:i\ne k\}$ is linearly independent over $K$: multiply a linear relation on the left by $q_j^T$ and on the right by $q_j$.
Smith reduction over the DVR $R_{\mathbf p}$ is used below in its standard sense of diagonalization by invertible row and column operations; compare Cohen's Dedekind-domain Smith theorem \cite[Theorem~1.7.2]{Cohen2000}.

\begin{definition}\label{def:local-obstruction-data}
Assume $n\ge2$. For a symmetric matrix $X=(x_{ij})\in M_n(K)$, let $\operatorname{uvec}(X)$ be the column vector of its upper-triangular entries in a fixed lexicographic order. Fix a nonzero prime ideal $\mathbf p$, choose a generator $\delta_{\mathbf p}$ of $\mathbf d_QR_{\mathbf p}$, and write
\begin{equation}
H_{\mathbf p}:=\delta_{\mathbf p}Q=(h_1\ \cdots\ h_n),
\qquad a_{\mathbf p}:=v_{\mathbf p}(\mathbf d_Q).
\end{equation}
Let $A_{\mathbf p}$ be the matrix with columns $\operatorname{uvec}(h_ih_i^T)$, $1\le i\le n-1$; for this paper we call it the \emph{local difference matrix} at $\mathbf p$. Let its nonzero Smith invariant factors over $R_{\mathbf p}$ be associates of
\begin{equation}
\pi^{\alpha_{1,\mathbf p}},\ldots,\pi^{\alpha_{n-1,\mathbf p}},
\qquad
\alpha_{1,\mathbf p}\le\cdots\le\alpha_{n-1,\mathbf p},
\end{equation}
where $\pi$ is a generator of the maximal ideal $\mathbf pR_{\mathbf p}$; two elements are \emph{associates} if they differ by a unit. We call the integers $\alpha_{i,\mathbf p}$ the \emph{Smith exponents}. Put
\begin{equation}
\beta_{i,\mathbf p}:=\max\{0,2a_{\mathbf p}-\alpha_{i,\mathbf p}\},
\qquad
\mathbf e_i:=\prod_{\mathbf p}\mathbf p^{\beta_{i,\mathbf p}}
\quad(1\le i\le n-1).
\end{equation}
For the present problem, we call $\mathbf e_i$ the $i$th \emph{obstruction ideal}.
\end{definition}
Only finitely many factors in the displayed product defining $\mathbf e_i$ are nontrivial.

We use the standard determinantal-ideal terminology of Bruns and Vasconcelos \cite{BrunsVasconcelos2003}.
\begin{definition}\label{def:content-determinantal}
For this paper, if $x=(x_1,\ldots,x_n)^T\in K^n$ is nonzero, define its \emph{fractional content ideal} by
\begin{equation}
\mathbf c(x):=(x_1,\ldots,x_n).
\end{equation}
Let $\wedge$ denote the exterior product in $\bigwedge^rK^n$. For linearly independent $x_1,\ldots,x_r$, define the \emph{exterior-content ideal} $\mathbf c(x_1\wedge\cdots\wedge x_r)$ to be the fractional ideal generated by the $r\times r$ minors of the matrix with columns $x_1,\ldots,x_r$. For a matrix $B$ over $K$, let $I_r(B)$ denote its $r$th determinantal ideal, i.e. the fractional ideal generated by its $r\times r$ minors.

Fix $k\in\{1,\ldots,n\}$ as reference coordinate and let $B^{(k)}$ have columns $\operatorname{uvec}(q_iq_i^T)$ for $i\ne k$. For each nonzero prime ideal $\mathbf p$, let
\begin{equation}
\alpha^{(k)}_{1,\mathbf p}\le\cdots\le\alpha^{(k)}_{n-1,\mathbf p}
\end{equation}
be the Smith exponents of $\delta_{\mathbf p}^2B^{(k)}$ over $R_{\mathbf p}$. Set
\begin{equation}
\mathbf D_0^{(k)}:=R,
\qquad
\mathbf D_j^{(k)}:=\mathbf d_Q^{2j}I_j(B^{(k)})\quad(1\le j\le n-1),
\end{equation}
\begin{equation}
\mathbf s_j^{(k)}:=\mathbf D_j^{(k)}(\mathbf D_{j-1}^{(k)})^{-1}
\quad(1\le j\le n-1).
\end{equation}
\end{definition}

